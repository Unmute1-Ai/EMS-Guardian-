# Argus pilot configuration. Copy to .env.production (git-ignored) and fill in.
# Used by: docker compose -f docker-compose.production.yml --env-file .env.production up -d

ARGUS_HOSTNAME=argus.pilot.example.gov
ARGUS_VERSION=pilot-1

# --- Agency sign-in (OIDC) ---
OIDC_ISSUER=https://login.example.gov/realms/argus
OIDC_CLIENT_ID=argus
OIDC_CLIENT_SECRET=
OAUTH2_PROXY_COOKIE_SECRET=        # openssl rand -base64 32 | tr -- '+/' '-_'
OIDC_REQUIRED_ROLE=argus-responder # optional; blank = any signed-in user
OIDC_ROLES_CLAIM=roles

# --- Compliance ---
# Blank = demo/synthetic data. "hipaa" or "fedramp" = fail closed (see docs/security/).
COMPLIANCE_MODE=

# --- AI ---
# Real PHI: Vertex AI under a Google Cloud BAA, service-account credentials mounted read-only.
GOOGLE_GENAI_USE_VERTEXAI=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=
# Synthetic-data pilots only:
GEMINI_API_KEY=

# --- Voice (optional) ---
ELEVENLABS_API_KEY=
ELEVENLABS_BAA=
