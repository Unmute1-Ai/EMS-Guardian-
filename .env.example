# Copy to .env.local for local dev. These are read ONLY by the API server
# (server/index.ts) and are never bundled into the browser app.

# Gemini: scenarios, reports, translation, Live sessions (via ephemeral tokens)
GEMINI_API_KEY=""

# ElevenLabs: spoken alerts (/api/tts)
ELEVENLABS_API_KEY=""

# Optional: API server port in dev (Vite proxies /api to it)
# API_PORT=8787
