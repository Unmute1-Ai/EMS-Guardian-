# Copy to .env.local for local dev. These are read ONLY by the API server
# (server/index.ts) and are never bundled into the browser app.

# Gemini: scenarios, reports, translation, Live sessions (via ephemeral tokens)
GEMINI_API_KEY=""

# ElevenLabs: spoken alerts (/api/tts)
ELEVENLABS_API_KEY=""

# Optional: API server port in dev (Vite proxies /api to it)
# API_PORT=8787

# ---- Sign-in (required in production) ----
# Agency OIDC provider; usually fronted by oauth2-proxy / ALB OIDC that forwards
# "Authorization: Bearer <access token>" to this server.
# OIDC_ISSUER="https://login.example.gov/realms/argus"
# OIDC_AUDIENCE="argus-api"
# OIDC_REQUIRED_ROLE="argus-responder"   # optional
# AUTH_DISABLED="true"                   # demos with synthetic data ONLY

# ---- Audit thread (signed, hash-chained; see server/audit.ts) ----
# Unset = a throwaway key per process and stdout only (fine for local dev).
# AUDIT_SIGNING_KEY_FILE="./secrets/audit-signing.pem"   # npm run audit:keygen -- ./secrets
# AUDIT_LOG_PATH="./audit/thread.jsonl"

# ---- Compliance ----
# COMPLIANCE_MODE="hipaa"   # or "fedramp"; server refuses to start if misconfigured
# TRUST_PROXY="1"
# GOOGLE_GENAI_USE_VERTEXAI="true"       # Gemini via Vertex AI (BAA / FedRAMP); uses service-account credentials
# GOOGLE_CLOUD_PROJECT="your-project"
# GOOGLE_CLOUD_LOCATION="us-central1"
# ELEVENLABS_BAA="true"                  # only if an ElevenLabs enterprise BAA is signed (hipaa mode)
