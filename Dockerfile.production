# Use multi-stage build for optimal image size.
# Serving mechanism: nginx static root. The final stage is nginx serving the
# Vite build output with the repo's nginx.conf (TLS, security headers, rate
# limits) as the single, actually-consumed serving configuration. No Node or
# Express server runs in production — the build output is the entire
# deployment surface.
# Builder: glibc Node 22 (npm 10). The former node:18-alpine builder hit
# npm/cli#4828 — npm 9 on musl skipped @tailwindcss/oxide's platform-specific
# native binding from the glibc-generated lockfile, failing `vite build`.
# Node 22 satisfies the engines floor (node >=18, npm >=9) and matches the
# glibc environment where CI and local builds are proven green.
FROM node:22 AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY tsconfig.json ./
COPY vite.config.ts ./

# Install dependencies
RUN npm ci

# Copy source code and static marketing pages
# (public/** — welcome/, argus/, accessguard/ — is copied verbatim into dist/)
# index.html is the Vite entry module — without it `vite build` fails with
# "Could not resolve entry module".
COPY index.html ./
COPY src ./src
COPY public ./public

# Build application
RUN npm run build

# Production stage — nginx static file server
FROM nginx:1.27-alpine

# Serving config: static root + TLS + security headers + rate limits
COPY nginx.conf /etc/nginx/nginx.conf

# App at / (dist/index.html) and marketing subpaths (/welcome/, /argus/,
# /accessguard/) all live in the single static root
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80 443

# Health check: loopback-only plain-HTTP endpoint on the nginx status server
# (no TLS cert dependency in the healthcheck itself)
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/health || exit 1

# Metadata labels
LABEL org.opencontainers.image.title="EMS Guardian"
LABEL org.opencontainers.image.description="U1 Field application and Unmute1AI product site, served statically"
LABEL org.opencontainers.image.version="1.0.0"
LABEL org.opencontainers.image.vendor="Unmute1ai"
LABEL org.opencontainers.image.documentation="https://github.com/Unmute1-Ai/EMS-Guardian-/blob/main/DEPLOYMENT_GUIDE.md"
